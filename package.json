{
  "name": "odontologia-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS Gestión Clínica Odontológica Vertical",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.2",
    "cache-manager": "^7.2.8",
    "dotenv": "^17.3.1"
  }
}
